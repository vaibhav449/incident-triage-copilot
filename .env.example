# Copy to .env and fill in:   cp .env.example .env
# Never commit .env. Add every new variable here, with a placeholder and a comment line above it.
# Variables follow docs/01-master-architecture.md (§7.1 DB roles, §5 M5 LLM client, §9 config).

# ── PostgreSQL (used by docker compose) ──
POSTGRES_DB=triage
POSTGRES_USER=triage_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ── Role-specific connections ──
# ingest, pipeline, API (no access to ground truth)
DATABASE_URL_RW=postgresql://triage_rw:change-me@localhost:5432/triage
# LLM query tools: SELECT-only on log tables
DATABASE_URL_RO=postgresql://triage_ro:change-me@localhost:5432/triage
# eval harness and `triage gold label` only: the one role that can read gold labels
DATABASE_URL_EVAL=postgresql://triage_eval:change-me@localhost:5432/triage

# ── LLM client ──
# api = hosted provider, local = open-weights model server
LLM_BACKEND=api
# model ID for the chosen backend (team decision pending, see docs/01 §17)
LLM_MODEL=
# API key for LLM_BACKEND=api; leave empty for local
LLM_API_KEY=
# optional base URL, e.g. http://localhost:11434 for a local Ollama server
LLM_BASE_URL=
